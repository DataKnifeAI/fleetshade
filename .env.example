# —— Site (Vite build / dev) ——
# Shared trust marker sent as header X-Dioptra-Site (must match API)
VITE_SITE_MARKER=change-me-to-a-long-random-string
VITE_STATUS_URL=/api/status

# —— API (server/index.mjs) ——
DIOPTRA_SITE_MARKER=change-me-to-a-long-random-string
DIOPTRA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://dioptra.dataknife.net
DIOPTRA_API_PORT=8787
DIOPTRA_API_HOST=0.0.0.0
DIOPTRA_REFRESH_SECONDS=30
DIOPTRA_RATE_LIMIT_PER_MIN=60
# Set to 1 to reject requests with no Origin/Referer (stricter; may break some same-origin GETs)
# DIOPTRA_REQUIRE_ORIGIN=0

# Dev proxy target for Vite
DIOPTRA_API_PROXY=http://127.0.0.1:8787

# —— Collectors (API + publish:status) ——
# GITHUB_TOKEN=
# DIOPTRA_GITHUB_ORG=DataKnifeAI
# DIOPTRA_GITHUB_REPOS=
# GITLAB_TOKEN=
# DIOPTRA_GITLAB_GROUP=
# GITLAB_URL=https://gitlab.com
# DIOPTRA_NODES_JSON=
# DIOPTRA_AGENTS_JSON=
# DIOPTRA_TOP_N=10
